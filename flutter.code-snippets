/*
Windows %APPDATA%\Code\User\snippets\(language).json
Mac $HOME/Library/Application Support/Code/User/snippets/(language).json
Linux $HOME/.config/Code/User/snippets/(language).json
*/
{
  // #region Debug
  "Debug Print (Flutter)": {
    "scope": "dart",
    "prefix": "c_debug_print",
    "body": "debugPrint(\"[C_${1:1}]: ${$2}\");",
  },
  "Debug Text (Flutter)": {
    "scope": "dart",
    "prefix": "c_debug_text",
    "body": "CText(\"[C_${1:1}]: ${$2}\"),",
  },
  // #endregion
  // #region Notifier
  "Build ValueListenableBuilder (Flutter)": {
    "scope": "dart",
    "prefix": "c_notifier_builder",
    "body": [
      "ValueListenableBuilder<${1:dynamic}>(",
      "  valueListenable: $2,",
      "  builder: (_, value, _) {",
      "    return ${3:Text(value.toString())};",
      "  },",
      "),"
    ],
  },
  // #endregion
  // #region Riverpod
  "Create Riverpod Notifier Raw (Flutter)": {
    "scope": "dart",
    "prefix": "c_riverpod_notifier",
    "body": [
      "// listen(UI render olmadan dinler), invalidate(Sifirlar), refresh(Sifirlar ve geriye ilk degeri doner), select(Objedenin icindeki bir parametreyi dinler), exists(bellekte mi?)",
      "// final count = ref.watch(counterProvider);",
      "// ref.read(counterProvider.notifier).increment();",
      "class ${1:Counter}Notifier extends Notifier<${2:int}> {",
      "  @override",
      "  $2 build() {",
      "    return ${3:0};",
      "  }",
      "",
      "  void increment([int amount = 1]) => state += amount;",
      "}",
      "final ${1/(.*)/${1:/downcase}/}Provider = NotifierProvider<$1Notifier, $2>($1Notifier.new);",
    ],
  },
  "Create Riverpod Controller (Flutter)": {
    "scope": "dart",
    "prefix": "c_riverpod_controller",
    "body": [
      "import 'package:riverpod_annotation/riverpod_annotation.dart';",
      "",
      "part '${1:counter}_controller.g.dart';",
      "",
      "// dart run build_runner build -> veya clean ile g.dart dosyalari olusturup(build) temizleyebilirsin(clean).",
      "// listen(UI render olmadan dinler), invalidate(Sifirlar), refresh(Sifirlar ve geriye ilk degeri doner), select(Objedenin icindeki bir parametreyi dinler), exists(bellekte mi?)",
      "// final count = ref.watch(counterProvider);",
      "// ref.read(counterProvider.notifier).increment();",
      "@Riverpod(name: \"${1/(.*)/${1:/downcase}/}Provider\")",
      "class ${1/(.*)/${1:/capitalize}/}Controller extends _\\$${1/(.*)/${1:/capitalize}/}Controller {",
      "  @override",
      "  build() {",
      "    return ${2:0};",
      "  }",
      "",
      "  void increment([int amount = 1]) => state += amount;",
      "}",
    ],
  },
  "Create Riverpod Async Controller (Flutter)": {
    "scope": "dart",
    "prefix": "c_riverpod_controller",
    "body": [
      "import 'package:riverpod_annotation/riverpod_annotation.dart';",
      "",
      "part '${1:email}_controller.g.dart';",
      "",
      "// listen(UI render olmadan dinler), invalidate(Sifirlar), refresh(Sifirlar ve geriye ilk degeri doner), select(Objedenin icindeki bir parametreyi dinler), exists(bellekte mi?)",
      "// final emailAsync = ref.watch(emailProvider);",
      "// ref.read(emailProvider.notifier).changeEmail();",
      "// emailAsync.when(data, loading, error)",
      "@Riverpod(name: \"${1/(.*)/${1:/downcase}/}Provider\")",
      "class ${1/(.*)/${1:/capitalize}/}Controller extends _\\$${1/(.*)/${1:/capitalize}/}Controller {",
      "  @override",
      "  FutureOr<${3:String}> build() async {",
      "    await Future.delayed(const Duration(seconds: 1));",
      "    return \"${2:user@test.com}\";",
      "  }",
      "",
      "  Future<void> changeEmail(String newEmail) async {",
      "    state = const AsyncValue.loading();",
      "",
      "    try {",
      "      await Future.delayed(const Duration(seconds: 1));",
      "",
      "      // Mevcut kullanıcıyı alıp ismi değiştirerek yeni state'i set ediyoruz",
      "      final currentEmail = state.value;",
      "      if (currentEmail != null) {",
      "        state = AsyncValue.data(newEmail);",
      "      }",
      "    } catch (e, st) {",
      "      state = AsyncValue.error(e, st);",
      "    }",
      "  }",
      "}",
    ],
  },
  // #endregion
  // #region Bloc
  "Build Bloc Builder (Flutter)": {
    "scope": "dart",
    "prefix": "c_bloc_builder",
    "body": [
      "StreamBuilder<${1:String}>(",
      "  stream: ${2:BlocName}.stream,",
      "  initialData: ${2:BlocName}.data,",
      "  builder: (context, snapshot) {",
      "    if(!snapshot.hasData || snapshot.data == null){",
      "      return const SizedBox.shrink();",
      "    }",
      "    return Text(snapshot.data.toString());",
      "  },",
      "),"
    ],
  },
  // #endregion
  // #region Tools
  "Singleton (Flutter)": {
    "scope": "dart",
    "prefix": "c_singleton",
    "body": [
      "static final instance = ${1:ClassName}._internal();",
      "$1._internal();"
    ],
  },
  // #endregion
  // #region Shimmer
  "Shimmer Init (Flutter)": {
    "scope": "dart",
    "prefix": "c_shimmer_init",
    "body": [
      "Shimmer.fromColors(",
      "  baseColor: Colors.grey.shade300,",
      "  highlightColor: Colors.grey.shade100,",
      "  child: Column(",
      "    children: [",
      "      $1",
      "    ],",
      "  ),",
      ");",
    ],
  },
  "Shimmer Item (Flutter)": {
    "scope": "dart",
    "prefix": "c_shimmer_item",
    "body": [
      "Container(height: ${1:24}, color: Colors.white),",
    ],
  },
  "Shimmer Long Text (Flutter)": {
    "scope": "dart",
    "prefix": "c_shimmer_long_text",
    "body": [
      "Column(",
      "  mainAxisSize: MainAxisSize.min,",
      "  crossAxisAlignment: CrossAxisAlignment.start,",
      "  spacing: ${2:8},",
      "  children: [",
      "    Container(height: ${1:10}, color: Colors.white),",
      "    Container(height: $1, color: Colors.white),",
      "    Container(height: $1, width: 100, color: Colors.white),",
      "  ],",
      "),",
    ],
  },
  // #endregion
  // #region Create
  "Create Screen (Flutter)": {
    "scope": "dart",
    "prefix": "c_screen",
    "body": [
      "import 'package:flutter/material.dart';",
      "",
      "class ${1:ClassName}Screen extends StatelessWidget {",
      "  static const route = '$1Screen';",
      "",
      "  const $1Screen({super.key});",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return Scaffold(",
      "      appBar: AppBar(title: const Text(route)),",
      "      body: Column(children: [body(route)]),",
      "    );",
      "  }",
      "",
      "  Widget body(String text) {",
      "    return Center(child: Text(text));",
      "  }",
      "}",
      ""
    ],
  },
  // #endregion
}